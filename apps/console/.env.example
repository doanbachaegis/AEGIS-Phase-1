# Reviewer Evidence Console (D4) — browser configuration.
#
# Only VITE_-prefixed names reach the browser bundle, and everything here is PUBLIC by
# construction: a contract ID and an RPC endpoint are exactly what §6.3 asks a reviewer
# to check the decision against independently. Never put a secret in this file — the
# console has no signer and never submits a transaction.
#
# VITE_STELLAR_RPC_URL, VITE_STELLAR_NETWORK_PASSPHRASE and VITE_CONTRACT_ID are
# REQUIRED: src/env.ts throws at load if any is missing, so a misconfigured deploy shows
# a configuration error instead of an empty evidence page.

VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# MUST be quoted: the value contains a ";".
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# The deployed authorization contract. Mirrors CONTRACT_ID in the repo-root .env — a
# redeploy is a config change here, not a code change.
VITE_CONTRACT_ID=CAAD6727VZDKH77IVZJ526B3YENMMU26DGHUEU3B4D6KK3JS5YTNTRPP

# Optional. Explorer path segment; defaults to "testnet".
VITE_STELLAR_EXPERT_NETWORK=testnet

# Optional. Lets the console print "USDC (testnet)" beside the raw SAC address. The raw
# address is always shown as well — the friendly name is never a substitute for it.
VITE_USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Optional, and normally LEFT EMPTY. Base URL of the AEGIS API, which supplies
# NON-authoritative display fields only (purpose, client_ref, settlement transaction
# hash), each tagged "display only" in the UI.
#
# Empty means SAME-ORIGIN. The gateway serves this bundle from one Railway service, so a
# relative `/v1/...` reaches the API that served the page — correct by construction, and
# still correct if the deployment moves to a new domain, which a baked-in absolute URL
# would not be. Set it only when the console is NOT served by the gateway.
#
# `pnpm dev` does not need it either: vite.config.ts proxies /v1 to a local gateway
# (override the target with AEGIS_DEV_GATEWAY).
#
# Either way the console renders the complete on-chain evidence without this API at all —
# which is the property §6.3 is asking for.
VITE_AEGIS_API_URL=

# Optional. Comma-separated intent references offered as example deep links on the home
# page — the "list of intent references" half of the §6.1 D4 evidence pack.
VITE_SAMPLE_INTENTS=
