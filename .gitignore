node_modules/
dist/
target/
.env
.env.*
!.env.example
*.wasm
.DS_Store
test_snapshots/

# packages/bindings/ is GENERATED (scripts/gen-bindings.sh) but COMMITTED, so a
# fresh clone installs and builds with no Rust toolchain and no `stellar` CLI.
# The `bindings-drift` CI job re-generates it and fails on any diff.
# Only its build output stays ignored — restated here so the intent survives an
# edit to the blanket rules above.
packages/bindings/dist/
packages/bindings/node_modules/

# Original SOW from the client — keep local, do not commit
docs/*.pdf

# Pitch/overview decks dropped at the repo root. Wildcarded on purpose: the next
# revision lands as "AEGIS v2.pdf" and would otherwise be committed by accident.
AEGIS*.pdf
