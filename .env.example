# AEGIS — server-side configuration. TESTNET ONLY.
#
# Copy to `.env` for local work. In a deployment these are set as service
# variables instead; both the gateway and the executor call Node's own
# `process.loadEnvFile()` on a `.env` next to them and treat its absence as
# normal, so a container needs no file at all. (`.env` is excluded from the
# Docker build context for exactly that reason — see .dockerignore.)
#
# The console is NOT configured from this file. It is a browser bundle and takes
# only `VITE_`-prefixed build-time variables — see apps/console/.env.example and
# DEPLOY.md. Nothing below is ever exposed to a browser, which is what keeps
# EXECUTOR_SECRET and OPERATOR_SECRET out of a public artifact.
#
# Deployment runbook: DEPLOY.md

# ─────────────────────────────────────────────────────────── Stellar network

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Required by the SDK's client options — and it is also one of the three inputs the USDC SAC
# address below is derived from (SPEC.md §5).
# MUST be quoted: the value contains a ";", which .env parsers treat as a comment.
# The stellar CLI auto-loads this file from the working directory, so an unquoted
# value makes every command fail with "rpc-url is used but network passphrase is missing".
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon. Executor only — it is how a submitted payment's fate is established
# (the ledger-close comparison that turns "unknown" into "proven absent").
# Optional; defaults to the testnet Horizon below.
HORIZON_URL=https://horizon-testnet.stellar.org

# The deployed authorization contract. Required by BOTH services.
# ⚠️ Redeploying the contract means changing this here AND rebuilding the
# console with the new VITE_CONTRACT_ID — Vite inlines it at build time.
CONTRACT_ID=

# ────────────────────────────────────────────────────────────────────── Keys
#
# Testnet keys only. Three distinct roles, and the separation is load-bearing:
#
#   OWNER     sets policy, registers and revokes agents. Owner-only on chain.
#   OPERATOR  calls `authorize` and `mark_settled` as `caller`. Cannot change
#             policy and cannot revoke an agent.
#   EXECUTOR  sources and signs the classic USDC payment. Is NOT an accepted
#             `caller` — the contract rejects it with Error #4
#             NotAuthorizedCaller — which is also what keeps the payment
#             envelope's sequence number away from the settle call.

# Executor — ⚠️ Phase 1 trusts this key (DECISIONS.md #6)
EXECUTOR_SECRET=

# Operator — the `caller` of `authorize` / `mark_settled`.
# Since DECISIONS.md #7, `caller: Address` is the FIRST parameter of both entry points; it is
# require_auth()'d and accepted iff it is the owner or the configured operator. Leave this empty
# to call as the owner instead — the owner is no longer locked out when an operator is set.
# ⚠️ This key can authorize and settle. It cannot change policy or revoke an agent (owner-only).
# REQUIRED by the executor (`mark_settled` has no owner fallback there).
OPERATOR_SECRET=

# Owner. The gateway falls back to this as `caller` when OPERATOR_SECRET is
# empty, and needs it regardless for `resolve`, which is owner-only on chain.
# Leave empty and the gateway starts, but /v1/decisions/:id/resolve cannot work.
OWNER_SECRET=

# Agent keys — ⚠️ Phase 1 keeps the agents' SECRET keys in the gateway process (DECISIONS.md #10).
# `authorize` needs two signatures: the caller above, and the agent itself via
# `agent.require_auth()`. SOW §4.1 D2 makes POST /v1/intents a single synchronous request, so
# there is no round trip in which an external agent could sign an auth entry.
# ⚠️ The cost, stated plainly: the contract's "a leaked operator key cannot impersonate another
# agent" check still runs on chain, but OPERATOR_SECRET and every key below now live in ONE
# process, so both signatures come from one trust domain. Misuse is detectable, not impossible —
# the same shape as EXECUTOR_SECRET above. Phase 2 replaces this with prepare/signAuthEntries/
# submit, which changes D2's API surface (DECISIONS.md #10).
# JSON object, agent public key (G...) -> agent secret key (S...). Testnet keys only.
# Must be ONE line. The gateway cross-checks each secret against the address it
# is filed under and refuses to start on a mismatch, so a copy-paste slip cannot
# become "signed as an agent nobody meant to sign as".
AGENT_SECRETS={}

# ──────────────────────────────────────────────────────────────────── Assets

# SAC for testnet USDC (issuer GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5).
# Settled 2026-09-04 — DECISIONS.md #5; derivation in packages/canonical/SPEC.md §5:
#   stellar contract id asset --asset USDC:GBBD47IF... --network testnet
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# ─────────────────────────────────────────────────────────────────── Gateway

# Railway injects PORT. The server binds 0.0.0.0 on whatever it is given.
PORT=8080
LOG_LEVEL=info

# Postgres. Optional: with no DATABASE_URL the gateway serves the chain path
# normally and reports `"database": "degraded"` on /health. That is a real
# deployment mode, not a broken one — the chain remains the evidence — but it
# loses the stored `purpose` and `client_ref` the console displays.
# ⚠️ Neon requires `?sslmode=require`; use the POOLED connection string.
DATABASE_URL=postgres://localhost:5432/aegis

# Cross-origin access for the console (browser only).
#
# Comma-separated allowlist. Unset means no CORS headers at all, which is the
# right setting when nothing calls this API from a browser.
#
# A leading `*.` label matches one subdomain, which is what Cloudflare Pages
# preview deployments need:
#   CORS_ORIGIN=https://aegis-console.pages.dev,https://*.aegis-console.pages.dev
#
# Getting this wrong degrades the console; it does not break it. The console
# reads the authoritative evidence from Soroban RPC, which sends
# `access-control-allow-origin: *` of its own accord. See DEPLOY.md.
CORS_ORIGIN=

# Path to the published service registry (services.json at the repo root).
# Optional; defaults to the repo root relative to the gateway's own location, so
# the gateway starts identically from any working directory.
SERVICE_REGISTRY_PATH=

# Path to the gateway's agent/policy registry (apps/gateway/registry.json).
# Optional; defaults to apps/gateway/registry.json, resolved the same way.
GATEWAY_REGISTRY_PATH=

# Seconds to wait for a submitted contract transaction to close before giving
# up. Optional; defaults to 45.
TX_TIMEOUT_SECONDS=45

# ────────────────────────────────────────────────────────────────── Executor

# SQLite settlement journal. Optional; defaults to
# apps/executor/.data/settlements.db, resolved from the working directory.
# ⚠️ In a container this path is EPHEMERAL unless a volume is mounted on it.
# The journal is the crash-recovery record for an in-flight payment — see
# DEPLOY.md before running a settlement against a container without one.
EXECUTOR_DB_PATH=

# Seconds of validity given to the payment envelope's `maxTime`. Optional;
# defaults to 180. Must be an integer in [30, 3600] — the executor refuses to
# start outside that range. Too short and a busy network abandons good payments;
# too long and reconciliation stalls waiting for the envelope to expire.
SETTLEMENT_TIMEOUT_SECONDS=180
